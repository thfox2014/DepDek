{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DepDek",
  "version": "0.1.0",
  "identifier": "com.agentworkbench.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:bundle"
  },
  "app": {
    "windows": [
      {
        "title": "DepDek",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "resources/node": "node",
      "../sidecar/dist/sidecar.mjs": "sidecar.mjs"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
