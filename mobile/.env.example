# All VITE_* values are PUBLIC metadata bundled into the frontend. Never put keys/passwords here.
MOBILE_API_PROXY=http://127.0.0.1:8787
VITE_MOBILE_BASE=/
# Optional pre-published provider metadata. The core still validates provider/revision/policy.
VITE_MOBILE_PROVIDER_ID=
VITE_MOBILE_PROFILE_REVISION=
VITE_MOBILE_MODEL_LABEL=
VITE_MOBILE_PROVIDER_CLOUD=1
VITE_MOBILE_ENGINE=deepseek-harness
# A server-authorized relative directory, NOT a local disk path or an authorization grant.
VITE_MOBILE_READ_PATH=
