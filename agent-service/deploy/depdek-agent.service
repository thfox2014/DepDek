[Unit]
Description=DepDek isolated DeepSeek Harness executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=depdek-agent
Group=depdek-agent
RuntimeDirectory=depdek-agent
RuntimeDirectoryMode=0750
UMask=0007
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DEPDEK_AGENT_SOCKET=/run/depdek-agent/agent.sock
Environment=DEPDEK_AGENT_MODEL=deepseek-v4-flash
EnvironmentFile=-/etc/depdek/agent.env
ExecStart=/usr/local/bin/depdek-agent
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=depdek-agent

[Install]
WantedBy=multi-user.target
