#!/bin/sh
set -eu

python3 -m venv /opt/depdek/venv
/opt/depdek/venv/bin/pip install --no-cache-dir 'vosk==0.3.45'

sed -i 's/^# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen
sed -i 's/^# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
cat > /etc/default/locale <<'EOF'
LANG=zh_CN.UTF-8
LANGUAGE=zh_CN:zh:en_US:en
EOF

install -d -m 0755 /etc/xdg/autostart
cat > /etc/xdg/autostart/depdek-ai-os.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=DepDek AI-OS Shell
Comment=Start the DepDek personal workbench
Exec=agent-workbench
Terminal=false
X-GNOME-Autostart-enabled=true
EOF
