#!/bin/sh
set -eu

python3 -m venv /opt/depdek/venv
/opt/depdek/venv/bin/pip install --no-cache-dir --no-index \
  --find-links=/usr/share/depdek/wheels 'vosk==0.3.45'

sed -i 's/^# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen
sed -i 's/^# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
cat > /etc/default/locale <<'EOF'
LANG=zh_CN.UTF-8
LANGUAGE=zh_CN:zh:en_US:en
EOF
im-config -n fcitx5

install -d -m 0755 /etc/systemd/system /etc/profile.d
install -D -m 0755 /usr/share/applications/jiaho.desktop /etc/skel/Desktop/jiaho.desktop

# The OS session is a display host. Private AI-OS access still requires the
# user's own native password; it is never a Webdesk admin / R1 identity.
ln -sfn /lib/systemd/system/graphical.target /etc/systemd/system/default.target
systemctl enable lightdm.service jiaho-session-user.service jiaho-model.service
plymouth-set-default-theme jiaho
update-initramfs -u -k all

install -m 0755 /usr/share/depdek/depdek-shell /usr/local/bin/depdek-shell
install -m 0644 /usr/share/depdek/depdek-welcome.sh /etc/profile.d/depdek-welcome.sh
chmod 0755 /usr/lib/jiaho/select-session-user
chmod 0755 /usr/lib/jiaho/start-session /usr/local/bin/jiaho
desktop-file-validate /usr/share/xsessions/jiaho.desktop /usr/share/applications/jiaho.desktop
