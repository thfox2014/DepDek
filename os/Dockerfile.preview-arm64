# Native ARM runner for an x86 guest on Apple Silicon; never nest x86 QEMU
# inside the x86-emulated compiler. Bind published ports to host loopback.
FROM depdek-ai-os-qemu:trixie-arm64
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends novnc websockify \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
