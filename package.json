{
  "name": "agent-workbench",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev:mobile": "npm --prefix mobile run dev",
    "build:mobile": "npm --prefix mobile run build",
    "test:mobile": "npm --prefix mobile test",
    "dev": "vite --port 1420 --strictPort",
    "dev:preview": "node scripts/dev-preview.mjs",
    "build": "npm run version:check && tsc && vite build",
    "build:sidecar": "npm --prefix sidecar run build",
    "test:ai-os-setup": "node --test scripts/ai-os-setup.test.mjs",
    "test:ai-os-room": "node --test scripts/ai-os-room.test.mjs",
    "test:room-workspaces": "node --test scripts/room-workspaces.test.mjs",
    "preview:ai-os-room": "node scripts/preview-ai-os-room.mjs",
    "preview:treasure": "node scripts/preview-treasure.mjs",
    "preview:documents": "node scripts/preview-treasure.mjs --documents",
    "test:documents": "node --test scripts/document-scenes.test.mjs",
    "test:documents-native": "node --test scripts/native-documents.test.mjs",
    "test:treasure": "node --test scripts/treasure.test.mjs",
    "test:photo-classification": "node --test scripts/photo-classification.test.mjs",
    "test:videos": "node --test scripts/video-library.test.mjs",
    "test:os-startup": "node --test scripts/os-startup.test.mjs",
    "test:wukong-moments": "node --test scripts/wukong-moments.test.mjs",
    "preview:videos": "node scripts/preview-treasure.mjs --videos",
    "test:file-library": "node --test scripts/file-library.test.mjs",
    "preview:ai-os-wizard": "node scripts/preview-ai-os-wizard.mjs",
    "space:test": "cargo test --manifest-path space-service/Cargo.toml",
    "space:build": "cargo build --manifest-path space-service/Cargo.toml --release",
    "agent:test": "cargo test --manifest-path agent-service/Cargo.toml",
    "agent:build": "cargo build --manifest-path agent-service/Cargo.toml --release",
    "daemon:test": "cargo test --manifest-path services/depdekd/Cargo.toml",
    "daemon:build": "cargo build --manifest-path services/depdekd/Cargo.toml --release",
    "prepare:bundle": "npm run build && npm run build:sidecar && node scripts/prepare-sidecar.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:bump": "node scripts/version.mjs bump"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "dompurify": "^3.4.13",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "~5.6.2",
    "vite": "^5.4.8"
  }
}
